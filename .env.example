BOT_TOKEN=your_telegram_bot_token_here
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Incoming Telegram bot updates: api/webhook — заголовок x-telegram-bot-api-secret-token (значение = secret_token из setWebhook).
WEBHOOK_SECRET_TOKEN=your_random_secret_string_here

# Отдельно: api/remind — проверка query ?secret= (не путать с WEBHOOK_SECRET_TOKEN).
WEBHOOK_SECRET=your_random_secret_string_here

NODE_ENV=development

# AI v1 (optional, pilot only in coaching flow)
AI_ENABLED=0
AI_NO_STRATEGY_ENABLED=0
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=7000
AI_RETRIES=1
